# Copy to `.env` in the repo root and adjust as needed.
# The API server loads this file automatically on startup.

# --- Postgres -----------------------------------------------------------------
# Optional. When unset, the API server uses an embedded Postgres (PGlite) and
# stores data under `.data/pglite`, then seeds the demo dataset automatically.
# Set this to use a real Postgres 14+ instance: local, Docker, Neon, Supabase...
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/cybershield

# --- Auth ---------------------------------------------------------------------
JWT_SECRET=change-this-to-a-long-random-string

# --- Services -----------------------------------------------------------------
# Express API server port (the Vite dev server proxies /api here).
PORT=8080

# Python ML service (Flask) that the API server forwards /api/ml/* to.
ML_SERVICE_URL=http://127.0.0.1:5000
ML_SERVICE_TIMEOUT_MS=20000

# --- Frontend (optional) ------------------------------------------------------
# Where Vite sends /api during `pnpm dev`. Defaults to http://127.0.0.1:8080.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8080
